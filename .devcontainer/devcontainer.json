{
  "name": "flyevo (cpu)",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "postCreateCommand": "uv sync --extra dev && uv run pre-commit install",
  "forwardPorts": [9090, 5000],
  "containerEnv": { "UV_LINK_MODE": "copy" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
    }
  }
}
